# Rename this example to secrets.toml, set your OWN username and SHA-256 hash.
# Never commit or share the real file.
AUTH_USER = "YOUR_USERNAME"
AUTH_PASS_HASH = "REPLACE_WITH_SHA256_OF_YOUR_PASSWORD"

